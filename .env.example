# Copy to .env. Never commit real keys or credential-bearing RPC URLs.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Neon Free PostgreSQL connection string. Server-only; never VITE_ prefix.
DATABASE_URL=
# Direct Neon endpoint for migration, never a VITE_ variable.
DATABASE_URL_UNPOOLED=
# Optional independent logical executor RPC endpoints.
CONTENT_ARKIV_RPC_URL=
PREVIEW_ARKIV_RPC_URL=
# Test-only EOA keys. All functions share the Vercel project's trust boundary.
DEMO_OWNER_PRIVATE_KEY=
ATTACKER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
DEMO_OWNER_ADDRESS=
AGENT_ADDRESS=
DEPLOYMENT_ID=
DEMO_SESSION_SECRET=
# Optional Vercel AI Gateway FREE credits only. No paid provider fallback.
AI_GATEWAY_API_KEY=
BOUND_MODEL=
# Exact public origin; localhost only for development.
PUBLIC_ORIGIN=http://localhost:5174

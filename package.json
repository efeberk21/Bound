{
  "name": "bound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": "22.x" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:tools-only": "node --import tsx scripts/dev.ts --tools-only",
    "build": "tsc --noEmit && npm run build --workspace @bound/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/live.test.ts --exclude \"tests/*database.test.ts\"",
    "test:db": "vitest run tests/database.test.ts tests/chain-database.test.ts tests/migrations-database.test.ts",
    "test:live": "vitest run tests/live.test.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "setup:env": "node --import tsx scripts/setup-env.ts",
    "arkiv:probe": "node --import tsx scripts/arkiv-probe.ts",
    "verify": "node --import tsx scripts/verify.ts",
    "demo:independent": "node --import tsx scripts/independent-demo.ts",
    "evidence:export": "node --import tsx scripts/export-evidence.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@bound/core": "0.1.0",
    "@neondatabase/serverless": "1.2.0",
    "iron-session": "9.0.1"
  }
}
